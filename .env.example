# Copy to .env and fill in. Generate keys with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"                                  (LLX_SECRET_KEY)
#   python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"     (LLX_ENCRYPTION_KEY)
LLX_SECRET_KEY=
LLX_ENCRYPTION_KEY=
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=lorvenlax
MINIO_ROOT_PASSWORD=change-me-too
# Optional: enable Claude for test planning and the assistant
LLX_ANTHROPIC_API_KEY=
LLX_AI_MODEL=claude-opus-5-5
# Hosts on private networks that tests may reach (the bundled sample app is "sample")
LLX_ALLOWED_PRIVATE_HOSTS=sample
